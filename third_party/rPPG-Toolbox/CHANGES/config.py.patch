+def _expand_env_vars(obj):
+    """Recursively expand ${VAR} environment variable references in strings."""
+    if isinstance(obj, str) and '${' in obj:
+        return os.path.expandvars(obj)
+    elif isinstance(obj, dict):
+        return {k: _expand_env_vars(v) for k, v in obj.items()}
+    elif isinstance(obj, list):
+        return [_expand_env_vars(v) for v in obj]
+    return obj
+
+
 def _update_config_from_file(config, cfg_file):
     config.defrost()
     with open(cfg_file, 'r') as f:
         yaml_cfg = yaml.load(f, Loader=yaml.FullLoader)
 
+    # Expand environment variables (e.g., ${KR_RPPG_ROOT}) in all string values
+    yaml_cfg = _expand_env_vars(yaml_cfg)
+    _unresolved = sorted(set(re.findall(r'\$\{([A-Za-z_][A-Za-z0-9_]*)\}', yaml.safe_dump(yaml_cfg))))
+    if _unresolved:
+        raise ValueError(f'{cfg_file}: environment variable(s) not set: {", ".join(_unresolved)}')
+
     for cfg in yaml_cfg.setdefault('BASE', ['']):
         if cfg:
             _update_config_from_file(
