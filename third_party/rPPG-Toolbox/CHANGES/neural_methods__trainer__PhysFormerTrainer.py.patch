+    def get_hr(self, y, sr=30, min=40, max=180):
+        """Calculate heart rate from PPG signal with bounds checking."""
+        try:
+            p, q = welch(y, sr, nfft=1e5/sr, nperseg=np.min((len(y)-1, 256)))
+            valid_mask = (p > min/60) & (p < max/60)
+            if not np.any(valid_mask):
+                # If no valid frequencies found, return middle of range
+                return (min + max) / 2.0
+            hr = p[valid_mask][np.argmax(q[valid_mask])] * 60
+            # Ensure HR is within valid range
+            return np.clip(hr, min, max-1)  # max-1 to avoid index 140 in loss function
+        except Exception as e:
+            # Fallback to a reasonable default if calculation fails
+            return 75.0  # Normal resting heart rate
